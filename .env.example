# Supabase Configuration (Client-side - Safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Alternatively, NEXT_PUBLIC_ prefix is also supported via vite.config.js:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-side only (Supabase Edge Function / Vercel Serverless - NEVER expose in frontend)
# SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
# RESEND_API_KEY=re_your_resend_api_key
# NOTIFICATION_TO_EMAIL=owner@yourbusiness.example
# NOTIFICATION_FROM_EMAIL=Website Enquiries <onboarding@resend.dev>

